{
  "entities": {
    "Submission": {
      "title": "Submission",
      "description": "Registration submission for a module",
      "type": "object",
      "properties": {
        "moduleId": { "type": "string" },
        "moduleTitle": { "type": "string" },
        "subGameId": { "type": "string" },
        "subGameTitle": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "university": { "type": "string" },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fullName": { "type": "string" },
              "cnic": { "type": "string" },
              "contactNumber": { "type": "string" }
            },
            "required": ["fullName", "cnic", "contactNumber"]
          }
        },
        "receiptBase64": { "type": "string" },
        "totalFee": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["moduleId", "moduleTitle", "email", "university", "members", "receiptBase64", "totalFee", "status", "createdAt", "updatedAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin user profile",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "superadmin"] }
      },
      "required": ["email", "role"]
    },
    "Counter": {
      "title": "Module Counter",
      "description": "Sequential counter for module submissions",
      "type": "object",
      "properties": {
        "count": { "type": "integer", "minimum": 0 }
      },
      "required": ["count"]
    }
  },
  "firestore": {
    "submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Collection of event registration submissions"
    },
    "admins/{userId}": {
      "schema": "Admin",
      "description": "Collection of authorized admin users"
    },
    "counters/{moduleId}": {
      "schema": "Counter",
      "description": "Collection of sequential counters for each module"
    }
  }
}
