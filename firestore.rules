rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'anasmobin0@gmail.com' ||
        request.auth.token.email == 'technova26@technova.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isServerTimestamp(field) {
      return incoming()[field] == request.time;
    }

    // Submission Validation
    function isValidSubmission(data) {
      return data.moduleId is string &&
             data.moduleTitle is string &&
             (data.get('subGameId', null) == null || data.subGameId is string) &&
             (data.get('subGameTitle', null) == null || data.subGameTitle is string) &&
             data.email is string && data.email.size() <= 255 && data.email != 'nigga123@niggers.com' &&
             data.university is string && data.university.size() <= 255 &&
             data.members is list && data.members.size() >= 1 && data.members.size() <= 10 &&
             data.totalFee is number && data.totalFee >= 0 &&
             data.receiptBase64 is string && data.receiptBase64.size() <= 1500000 && 
             (data.get('participantId', null) == null || data.participantId is string) &&
             (data.get('promoCode', null) == null || data.promoCode is string) &&
             (data.get('discountApplied', null) == null || data.discountApplied is number) &&
             (data.get('exempted', null) == null || data.exempted is bool) &&
             data.status in ['pending', 'approved', 'rejected'];
    }

    match /submissions/{submissionId} {
      allow create: if (
        isValidSubmission(incoming()) &&
        incoming().status == 'pending' &&
        isServerTimestamp('submittedAt')
      );

      allow get: if isAdmin();
      allow list: if isAdmin();

      allow update: if (
        isAdmin() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'exempted', 'participantId', 'moduleId', 'moduleTitle']) &&
        isServerTimestamp('updatedAt')
      );

      allow delete: if isAdmin();
    }

    match /counters/{moduleId} {
      allow get: if true;
      allow create: if true; // Technically anyone can initialize, but it's safe if validated
      allow update: if (
        incoming().count == existing().count + 1 &&
        incoming().diff(existing()).affectedKeys().hasOnly(['count'])
      );
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.email == request.auth.token.email;
      allow write: if false; // Only manageable via Firebase Console or Admin SDK
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
