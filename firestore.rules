rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      // Bootstrapped admins
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'anasmobin0@gmail.com' ||
        request.auth.token.email == 'technova26@technova.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---

    function isValidSubmission(data) {
      return data.moduleId is string && data.moduleId.size() <= 64 &&
             data.moduleTitle is string && data.moduleTitle.size() <= 128 &&
             data.email is string && data.email.size() <= 128 && data.email.matches('^[^@]+@[^@]+\\.[^@]+$') &&
             data.university is string && data.university.size() <= 200 &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.totalFee is number && data.totalFee >= 0 &&
             data.members is list && data.members.size() >= 1 && data.members.size() <= 10 &&
             data.members[0].fullName is string && data.members[0].fullName.size() <= 100 &&
             data.submittedAt == request.time;
    }

    // --- Collection Routes ---

    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      // Only the first bootstrapped admin can add others or system internal
      allow write: if isAdmin();
    }

    match /submissions/{submissionId} {
      // Pillar 8: Secure List Queries & PII Isolation
      allow list: if isAdmin();
      allow get: if isAdmin() || (isSignedIn() && existing().email == request.auth.token.email);

      allow create: if isSignedIn() && 
                      isValidId(submissionId) && 
                      isValidSubmission(incoming()) && 
                      incoming().status == 'pending';

      allow update: if isAdmin() && 
                      isValidSubmission(incoming()) && 
                      // Only let admins change status or specific fields
                      incoming().diff(existing()).affectedKeys().hasOnly(['status', 'totalFee']);

      allow delete: if isAdmin();
    }
  }
}
