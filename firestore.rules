rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'anasmobin0@gmail.com' ||
        request.auth.token.email == 'technova26@technova.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isServerTimestamp(field) {
      return incoming()[field] == request.time;
    }

    // Submission Validation
    function isValidSubmission(data) {
      return data.moduleId is string && data.moduleId.size() <= 100 &&
             data.moduleTitle is string && data.moduleTitle.size() <= 200 &&
             data.email is string && data.email.size() <= 255 &&
             data.university is string && data.university.size() <= 255 &&
             data.members is list && data.members.size() >= 1 && data.members.size() <= 5 &&
             data.totalFee is number && data.totalFee >= 0 &&
             data.receiptBase64 is string && (data.receiptBase64.size() <= 2000000 || data.receiptBase64.size() == 0) && // Allow up to 2MB as I added compression but base64 is large
             data.status in ['pending', 'approved', 'rejected'];
    }

    match /submissions/{submissionId} {
      allow create: if (
        isValidId(submissionId) &&
        isValidSubmission(incoming()) &&
        incoming().status == 'pending' &&
        isServerTimestamp('submittedAt') &&
        isServerTimestamp('createdAt') &&
        isServerTimestamp('updatedAt')
      );

      allow get: if isAdmin();
      allow list: if isAdmin();

      allow update: if (
        isAdmin() &&
        isValidSubmission(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        isServerTimestamp('updatedAt')
      );

      allow delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false; // Only manageable via Firebase Console or Admin SDK
    }
  }
}
